PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/pillsync
JWT_ACCESS_SECRET=replace-with-a-long-local-secret
JWT_REFRESH_SECRET=replace-with-another-long-local-secret

# Optional SMTP delivery. Without these values, notifications remain locally queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PillSync <notifications@example.com>

# Optional Twilio SMS delivery. Without these values, notifications remain locally queued.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Internal OCR service. The browser must never call this URL directly.
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_INTERNAL_TOKEN=replace-with-a-local-internal-token
